{
  "name": "tournament-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Volleyball Tournament – two independent frontends (user :5173/:8080 read-only, admin :5174/:8081 management) – implements frontend_separation_spec_v1.0",
  "scripts": {
    "dev": "vite",
    "dev:user": "vite --config apps/user/vite.config.ts",
    "dev:admin": "vite --config apps/admin/vite.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:user": "tsc --noEmit -p apps/user/tsconfig.json && vite build --config apps/user/vite.config.ts",
    "build:admin": "tsc --noEmit -p apps/admin/tsconfig.json && vite build --config apps/admin/vite.config.ts",
    "build:all": "npm run build:user && npm run build:admin",
    "preview": "vite preview",
    "preview:user": "vite preview --config apps/user/vite.config.ts",
    "preview:admin": "vite preview --config apps/admin/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-server": "tsx test-server/src/server.ts",
    "dev:test-server": "tsx watch test-server/src/server.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.0",
    "msw": "^2.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  }
}
