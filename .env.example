# Backend URL (admin doc §2, frontend doc §12). Single source of truth
# read by src/config/runtime.ts — never hard-code IPs/URLs in components.
# Local backend:
VITE_API_BASE_URL=http://localhost:8080
# Local test server (`npm run test-server`):
# VITE_API_BASE_URL=http://localhost:4000
# Production example:
# VITE_API_BASE_URL=https://api.example.com
