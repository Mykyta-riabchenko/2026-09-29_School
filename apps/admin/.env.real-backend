# Local dev against the real backend at 10.57.82.127 (proxy mode).
# Empty base = relative /api URLs (same origin, no browser CORS).
# Reads go to :8080, writes + lifecycle to :8081 (see vite.config.ts).
# Gitignored - local only. Restart the dev server after changing this file.
VITE_API_BASE_URL=
VITE_PROXY_PUBLIC_TARGET=http://10.57.82.127:8080
VITE_PROXY_ADMIN_TARGET=http://10.57.82.127:8081
